# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tests / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# C++ / CMake
cmake-build-*/
build_cpp/
*.o
*.a
*.so

# Lean proof project (commit sources + pins, never build outputs)
lean/.lake/
lean/.elan/
lean/build/

# Local artifacts
*.log
*.ipynb_checkpoints/
.DS_Store

# Run artifacts (Decision 2026-08-16): recorded runs + machine ledger never
# go into git — they are regenerated by the bench suite and archived locally.
# raw per-run artifacts + checkpoints stay local (provenance is in the ledger + reports)
results/*
!results/N1v2-report.md
!results/ledger.csv
!results/EXPERIMENT-LOG.md
# N2 launch-prep deliverables (CPU-only, small, self-contained) are tracked.
# The earlier Aug-16 layer-0 smoke point dirs are intentionally NOT re-added
# here: they already exist on disk with full run.json provenance, and a future
# reader can regenerate their numbers from the run command + handoff if needed.
# Do NOT blanket-unignore results/N2/ — that would pull in the per-point dirs.
scripts/n2_prepare.py

# checkpoints (large, gitignored)
results/*ckpt*/
*.pt
weights/
.hf_cache/
*.safetensors

# Kaggle: the self-contained kernel bundle is GENERATED at push time from
# scripts/kaggle/kernel_template.py + scripts/build_kaggle_kernel.py
# (it embeds the whole qicert package as base64, so it must not be committed
# — it would go stale and bloat the repo).
kaggle/n1_baseline.py
kaggle-out/

# Local venvs / run artifacts
.venv*/
results/*ckpt*/
*.pt

# LaTeX build artifacts
docs/*.aux
docs/*.log
docs/*.out
docs/*.synctex.gz

